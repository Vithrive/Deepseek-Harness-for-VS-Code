{
  "name": "dsh-vscode-open-external",
  "version": "0.1.0",
  "description": "DeepSeek Harness 插件：DSH 页面被外层宿主（VS Code 扩展 webview）内嵌时，把页面里的 window.open（如 DeepSeek 账号登录的授权链接）转交给宿主，用系统默认浏览器打开。由 Deepseek-Harness-for-VS-Code 扩展内置分发。",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "cordis",
    "plugin",
    "vscode",
    "webview",
    "login",
    "browser"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
