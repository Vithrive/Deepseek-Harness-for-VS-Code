  "tokenColors": [
    {
      "scope": [
        "meta.embedded",
        "source.groovy.embedded",
        "string meta.image.inline.markdown",
        "variable.other"
      ],
      "settings": {
        "foreground": "#EDEDED"
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#ADB5BD",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "meta.string",
        "support.constant.property-value",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#69DB7C"
      }
    },
    {
      "name": "String interpolation",
      "scope": [
        "meta.interpolation",
        "variable.interpolation",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#8CE99A"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#FAA2C1"
      }
    },
    {
      "name": "Control flow",
      "scope": [
        "keyword.control.flow",
        "punctuation.definition.keyword"
      ],
      "settings": {
        "foreground": "#FAA2C1"
      }
    },
    {
      "name": "Constants and numbers",
      "scope": [
        "constant",
        "constant.numeric",
        "constant.language",
        "support.constant",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#4DABF7"
      }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "meta.function entity.name.function"
      ],
      "settings": {
        "foreground": "#B197FC"
      }
    },
    {
      "name": "Parameters and properties",
      "scope": [
        "variable.parameter",
        "meta.parameter",
        "variable.other.property",
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#FFA94D"
      }
    },
    {
      "name": "Types and classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#4DABF7"
      }
    },
    {
      "name": "Punctuation and operators",
      "scope": [
        "punctuation",
        "meta.brace",
        "keyword.operator",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#CED4DA"
      }
    },
    {
      "name": "Markup links",
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#74C0FC"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#EC1313"
      }
    }
  ],
  "semanticTokenColors": {
    "newOperator": "#FAA2C1",
    "stringLiteral": "#69DB7C",
    "customLiteral": "#4DABF7",
    "numberLiteral": "#4DABF7",
    "typeKeyword": "#FAA2C1",
    "comment": {
      "foreground": "#ADB5BD",
      "italic": true
    },
    "Documentation": "#ADB5BD",
    "parameter": "#FFA94D",
    "property": "#FFA94D",
    "type": "#4DABF7",
    "class": "#4DABF7",
    "interface": "#4DABF7",
    "enum": "#4DABF7",
    "struct": "#4DABF7",
    "namespace": "#FAA2C1",
    "label": "#FAA2C1",
    "variable.defaultLibrary": "#4DABF7",
    "function.defaultLibrary": "#B197FC",
    "macro": "#FAA2C1",
    "modifier.readonly": "#FAA2C1",
    "modifier.deprecated": {
      "foreground": "#ADB5BD",
      "strikethrough": true
    }
  }
}
