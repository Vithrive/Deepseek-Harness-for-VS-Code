  "tokenColors": [
    {
      "scope": [
        "meta.embedded",
        "source.groovy.embedded",
        "string meta.image.inline.markdown",
        "variable.other"
      ],
      "settings": {
        "foreground": "#0F1115"
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#868E96",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "meta.string",
        "support.constant.property-value",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#2F9E44"
      }
    },
    {
      "name": "String interpolation",
      "scope": [
        "meta.interpolation",
        "variable.interpolation",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#2B8A3E"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#D6336C"
      }
    },
    {
      "name": "Control flow",
      "scope": [
        "keyword.control.flow",
        "punctuation.definition.keyword"
      ],
      "settings": {
        "foreground": "#D6336C"
      }
    },
    {
      "name": "Constants and numbers",
      "scope": [
        "constant",
        "constant.numeric",
        "constant.language",
        "support.constant",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#1C7ED6"
      }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "meta.function entity.name.function"
      ],
      "settings": {
        "foreground": "#6741D9"
      }
    },
    {
      "name": "Parameters and properties",
      "scope": [
        "variable.parameter",
        "meta.parameter",
        "variable.other.property",
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#E8590C"
      }
    },
    {
      "name": "Types and classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#1C7ED6"
      }
    },
    {
      "name": "Punctuation and operators",
      "scope": [
        "punctuation",
        "meta.brace",
        "keyword.operator",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#495057"
      }
    },
    {
      "name": "Markup links",
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#1971C2"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#EC1313"
      }
    }
  ],
  "semanticTokenColors": {
    "newOperator": "#D6336C",
    "stringLiteral": "#2F9E44",
    "customLiteral": "#1C7ED6",
    "numberLiteral": "#1C7ED6",
    "typeKeyword": "#D6336C",
    "comment": {
      "foreground": "#868E96",
      "italic": true
    },
    "Documentation": "#868E96",
    "parameter": "#E8590C",
    "property": "#E8590C",
    "type": "#1C7ED6",
    "class": "#1C7ED6",
    "interface": "#1C7ED6",
    "enum": "#1C7ED6",
    "struct": "#1C7ED6",
    "namespace": "#D6336C",
    "label": "#D6336C",
    "variable.defaultLibrary": "#1C7ED6",
    "function.defaultLibrary": "#6741D9",
    "macro": "#D6336C",
    "modifier.readonly": "#D6336C",
    "modifier.deprecated": {
      "foreground": "#868E96",
      "strikethrough": true
    }
  }
}
